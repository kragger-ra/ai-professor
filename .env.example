PYTHONPATH=src
GRADIO_SERVER_PORT=22229
GRADIO_SERVER_NAME="0.0.0.0"
HUD_LAYER_PORT=22236


# === Идентичность агента ===
SELF_NAME="Professor"
BOT_NICKNAMES="Professor,Профессор,профессор"


# === TTS ===
# Only "vosk" is supported. Leave unset to use the built-in default.
TTS_BACKEND="vosk"
VOSK_SPEAKER_ID=4
VOSK_TTS_URL="http://localhost:22232"


# === Распознавание речи (STT) ===
# Модели: tiny, small, medium, large-v3-turbo
# Для лучшего русского: "dvislobokov/faster-whisper-large-v3-turbo-russian"
FASTER_WHISPER_MODEL_NAME="small"
STT_COMPUTE_DEVICE="cpu"


# === Аудио (индивидуальный режим, без VoiceMeeter) ===
# AUDIO_MODE=none — TTS играет напрямую через системное устройство.
# Используй local/meeting только если у тебя установлен VoiceMeeter Banana
# и нужна маршрутизация для созвонов (Lecture-сборка).
AUDIO_MODE=none

# Имена аудиоустройств. Пустые значения = системный default
# (sounddevice.default.device / soundcard.default_speaker()).
# Подсмотреть имена можно так:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
# Примеры реальных имён: "Наушники (Realtek HD Audio)", "Sound Blaster X3", "USB Audio Device"
SOUND_DEVICE_IN=""
SOUND_DEVICE_OUT=""
FX_SOUND_DEVICE_IN=""
FX_SOUND_DEVICE_OUT=""
SOUND_DEVICE_SR=48000

# Имя микрофона для STT. Пустое = системный default.
# Если default — встроенный микрофон ноутбука, лучше указать USB-микрофон явно.
MIC_DEVICE_NAME=""


# === Эмбеддинги (RAG) ===
EMBEDDINGS_MODEL="text-embedding-user-bge-m3"
EMBEDDINGS_API_BASE="http://localhost:22227/v1"
EMBEDDINGS_API_KEY="sk-1234"


# === LLM ===
# По умолчанию используется локальная Gemma E4B через LM Studio.
# См. STUDENT_QUICKSTART.md → раздел "LM Studio".
USE_LOCAL_LLM="true"

LM_STUDIO_API_BASE="http://localhost:22227/v1"
LM_STUDIO_API_KEY="sk-1234"
LM_STUDIO_MODEL_NAME="google/gemma-4-e4b"
LM_STUDIO_HEARTBEAT_INTERVAL="2.0"
LM_STUDIO_REASONING_EFFORT="none"
LM_STUDIO_FILTER_THINKING="true"

# Fallback на облачные API (если железо слабое — можно переключиться в Settings tab).
# Заполни нужный ключ и переключи модель через UI; ключ можно оставить пустым,
# если используешь только локальную модель.

# Mistral API
CORE_LLM_MODEL_NAME="mistral/mistral-large-latest"
MISTRAL_API_KEY=""

# Claude API (опционально)
# CORE_LLM_MODEL_NAME="anthropic/claude-sonnet-4-20250514"
# ANTHROPIC_API_KEY=""

# OpenRouter (опционально)
# OPENROUTER_API_KEY=""

CORE_LLM_REASONNING="NONE"
CORE_LLM_API_BASE=NONE
CORE_LLM_MAX_TOKENS=NONE

VISION_LLM_MODEL_NAME="NONE"


# === Лекции и метрики ===
LECTURE_WEEK=1
TRANSCRIPTS_DIR="data/transcripts"
SUMMARIES_DIR="resources/RAG/lecture_summaries"
METRICS_DB_PATH="data/metrics.db"
WAKE_WORDS_CONFIG="resources/Customization/wake_words.yml"


# === Прокси (раскомментировать при необходимости) ===
# proxy="http://127.0.0.1:2080"
# HTTP_PROXY=http://127.0.0.1:2080
# HTTPS_PROXY=http://127.0.0.1:2080
NO_PROXY="localhost,127.0.0.1,::1,0.0.0.0"

SPEECH_TO_TEXT_START=""
