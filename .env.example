PYTHONPATH=src
GRADIO_SERVER_PORT=22228
GRADIO_SERVER_NAME="0.0.0.0"
HUD_LAYER_PORT=22236


# === Идентичность агента ===
SELF_NAME="Professor"
BOT_NICKNAMES="Professor,Профессор,профессор"


# === TTS ===
# Only "vosk" is supported. Leave unset to use the built-in default.
TTS_BACKEND="vosk"
VOSK_SPEAKER_ID=4
VOSK_TTS_URL="http://localhost:22232"


# === Распознавание речи (STT) ===
# Модели: tiny, small, medium, large-v3-turbo
# Для лучшего русского: "dvislobokov/faster-whisper-large-v3-turbo-russian"
FASTER_WHISPER_MODEL_NAME="small"
STT_COMPUTE_DEVICE="cpu"


# === Аудио маршрутизация (Zoom) ===
# Кабель #1: Zoom speaker → STT (вход агента)
# Кабель #2: TTS → Zoom mic (выход агента)
# ВНИМАНИЕ: OUTPUT = микрофон, INPUT = динамик

# Кабель #1 — из Zoom
SOUND_DEVICE_IN="CABLE Output (VB-Audio Virtual Cable)"
# Кабель #2 — в Zoom
SOUND_DEVICE_OUT="CABLE-B Input (VB-Audio Virtual Cable B)"
FX_SOUND_DEVICE_IN="CABLE Output (VB-Audio Virtual Cable)"
FX_SOUND_DEVICE_OUT="CABLE-B Input (VB-Audio Virtual Cable B)"
SOUND_DEVICE_SR=48000


# === Эмбеддинги (RAG) ===
EMBEDDINGS_MODEL="text-embedding-user-bge-m3"
EMBEDDINGS_API_BASE="http://localhost:22227/v1"
EMBEDDINGS_API_KEY="sk-1234"


# === LLM ===
LM_STUDIO_API_BASE="http://localhost:22227/v1"
LM_STUDIO_API_KEY="sk-1234"
LM_STUDIO_MODEL_NAME="google/gemma-4-e4b"
LM_STUDIO_HEARTBEAT_INTERVAL="2.0"
LM_STUDIO_REASONING_EFFORT="none"
LM_STUDIO_FILTER_THINKING="true"

# === Локальная LLM через LM Studio (экспериментальная) ===
# Установить true для использования локальной модели вместо Mistral API
# Требует запущенный LM Studio с загруженной моделью (см. docs/LM_STUDIO_SETUP.md)
# Модель: Gemma 4 E4B (~5.9 GB VRAM), reasoning_effort=none отключает thinking
# TRIGGER_START в промпте отсекает leaked thinking от ответа
USE_LOCAL_LLM="false"

# Вариант 1: Локальная через LM Studio (litellm route, legacy)
# CORE_LLM_MODEL_NAME="lm_studio/"

# Вариант 2: Mistral API (бесплатно, неплохой русский)
CORE_LLM_MODEL_NAME="mistral/pixtral-large-latest"
MISTRAL_API_KEY=""

# Вариант 3: Claude API (лучшее качество, платно)
# CORE_LLM_MODEL_NAME="anthropic/claude-sonnet-4-20250514"
# ANTHROPIC_API_KEY=""

CORE_LLM_REASONNING="NONE"
CORE_LLM_API_BASE=NONE
CORE_LLM_MAX_TOKENS=NONE

# Vision LLM (опционально, для скриншотов/OBS)
VISION_LLM_MODEL_NAME="NONE"


# === Лекции и метрики ===
LECTURE_WEEK=1
TRANSCRIPTS_DIR="data/transcripts"
SUMMARIES_DIR="resources/RAG/lecture_summaries"
METRICS_DB_PATH="data/metrics.db"
WAKE_WORDS_CONFIG="resources/Customization/wake_words.yml"


# === Прокси (раскомментировать при необходимости) ===
# proxy="http://127.0.0.1:2080"
# HTTP_PROXY=http://127.0.0.1:2080
# HTTPS_PROXY=http://127.0.0.1:2080
NO_PROXY="localhost,127.0.0.1,::1,0.0.0.0"

SPEECH_TO_TEXT_START=""
