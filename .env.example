# =============================================================================
# AI Professor Tutor v2 — пример конфигурации
#
# 1) Скопируй файл в .env (cp .env.example .env / copy .env.example .env)
# 2) Выбери провайдер LLM и впиши ключ. Минимум, чтобы запустилось:
#       USE_LOCAL_LLM=false
#       OPENAI_API_KEY="sk-..."         (или Anthropic / DeepSeek / Yandex)
# 3) start_tutor_v2.bat — поднимет Vosk-TTS и тьютор.
#
# Все настройки можно редактировать и из UI борда:
#   Файл → Настройки подключений…  (LLM-провайдер и ключи)
#   Звук → Аудио-режим              (Локальный / Созвон)
# =============================================================================


# ----- LLM: какой мозг использует тьютор -------------------------------------
# true  => Локальная модель через LM Studio (OpenAI-совместимый сервер).
# false => Облачная модель по CORE_LLM_MODEL_NAME (через litellm).
USE_LOCAL_LLM="false"

# Облачная модель. Формат litellm:
#   openai/gpt-4o-mini, openai/gpt-5.4
#   anthropic/claude-3-5-sonnet-20241022, anthropic/claude-opus-4-7
#   deepseek/deepseek-chat
#   yandex/yandexgpt-pro/latest
#   mistral/mistral-large-latest
CORE_LLM_MODEL_NAME="openai/gpt-4o-mini"
# Опциональный override base URL (для прокси / совместимых провайдеров).
# NONE или пусто => дефолтный эндпоинт провайдера.
CORE_LLM_API_BASE="NONE"

# Ключи провайдеров — заполнить тот, который выбран в CORE_LLM_MODEL_NAME.
# Все ключи можно хранить одновременно; используется только активный.
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
# DeepSeek:  https://platform.deepseek.com/api_keys
# Yandex:    https://console.cloud.yandex.ru/ → AI Studio → API ключи
# Mistral:   https://console.mistral.ai/api-keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
MISTRAL_API_KEY=""


# ----- Локальный сервер LM Studio (когда USE_LOCAL_LLM=true) -----------------
# Установка LM Studio: https://lmstudio.ai/
# Запусти OpenAI-совместимый сервер в LM Studio, загрузи нужную модель,
# впиши тут URL и имя.
LM_STUDIO_API_BASE="http://localhost:22227/v1"
LM_STUDIO_API_KEY="sk-1234"
LM_STUDIO_MODEL_NAME="google/gemma-4-e4b"
LM_STUDIO_HEARTBEAT_INTERVAL="2.0"
# Для GPT-5.x: none|low|medium|high|xhigh. Для других моделей игнорируется.
LM_STUDIO_REASONING_EFFORT="none"
LM_STUDIO_FILTER_THINKING="true"


# ----- Мета-агент (лёгкий preflight параллельно RAG) ------------------------
# local => тот же LM Studio. cloud => отдельный лёгкий облачный LLM.
META_BACKEND="local"
META_LOCAL_MODEL=""
META_CLOUD_MODEL="openai/gpt-4o-mini"
META_CLOUD_API_BASE=""


# ----- Эмбеддинги (RAG-поиск по корпусу курса) -------------------------------
# По умолчанию — bge-m3 через тот же LM Studio (квантованный GGUF, 261 MB).
# Если RAG не нужен — можно оставить как есть; курс просто не будет
# подключаться, базовый Q&A продолжит работать.
EMBEDDINGS_MODEL="text-embedding-user-bge-m3"
EMBEDDINGS_API_BASE="http://localhost:22227/v1"
EMBEDDINGS_API_KEY="sk-1234"


# ----- STT (Faster-Whisper, локально) ----------------------------------------
# Модели: tiny | small | medium | large-v3 | large-v3-turbo
# Лучший русский: dvislobokov/faster-whisper-large-v3-turbo-russian
FASTER_WHISPER_MODEL_NAME="large-v3-turbo"
# cuda (нужен ctranslate2 + cuDNN/cuBLAS) либо cpu (медленнее в 3-5 раз).
STT_COMPUTE_DEVICE="cuda"
# Пусто => подбирается по device (float16 для cuda, int8 для cpu).
# Override: float16 | int8_float16 | int8 | float32
STT_COMPUTE_TYPE=""
# Сколько блоков по 100мс молчания достаточно, чтобы начать предварительную
# транскрипцию (раньше financial-time-to-first-token). 0 => выключить.
STT_SPECULATIVE_BLOCKS=3


# ----- TTS (Vosk-TTS сервер на :22232, локально) -----------------------------
# Поднимается автоматически через start_tutor_v2.bat (scripts/_run_vosk_tts.bat).
VOSK_TTS_URL="http://localhost:22232"
# ID голоса: 0..4 (рекомендован 3 или 4 для русского).
VOSK_SPEAKER_ID=3
# Темп речи: 0.8 = медленнее, 1.2 = быстрее.
VOSK_SPEECH_RATE=1.0
# Пост-обработка TTS (Pedalboard + LUFS): de-ess, EQ, compressor, reverb,
# normalize. on => включить, off => сырой Vosk.
TTS_POSTFX="off"


# ----- Аудио-роутинг ---------------------------------------------------------
# none     => Локальный режим (системный микрофон + системные колонки).
# meeting  => Маршрутизация через VoiceMeeter Banana (для Zoom / Контур.Толк
#             / OBS / etc.).
AUDIO_MODE="none"

# Имена устройств. Пусто => системный default.
# Подсмотреть имена:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
SOUND_DEVICE_IN=""
SOUND_DEVICE_OUT=""
SOUND_DEVICE_SR=48000

# Per-mode override (заполняется автоматически когда выбираешь режим в UI
# борда: Звук → Аудио-режим). Удобно если в локальном режиме хочется fifine
# + Sound Blaster, а в meeting — VoiceMeeter каналы.
SOUND_DEVICE_IN_LOCAL=""
SOUND_DEVICE_OUT_LOCAL=""
SOUND_DEVICE_IN_MEETING="Voicemeeter Out B2"
SOUND_DEVICE_OUT_MEETING="Voicemeeter Input"


# ----- UX ------------------------------------------------------------------
# Filler-фразы («Так…», «Минутку.») пока агент думает над ответом.
# on => играют через 2.5с молчания если ответ ещё не готов.
# off => тишина (по умолчанию — фидбэк юзера 27.05).
FILLERS="off"

# Тихий эмбиент (комнатный тон + редкий мур кота).
# on => играет, off => тихо (рекомендовано, эмбиент мешает STT).
AMBIENT_SOUND="off"


# ----- Прокси (опционально) -------------------------------------------------
# Раскомментировать при необходимости.
# HTTP_PROXY="http://127.0.0.1:2080"
# HTTPS_PROXY="http://127.0.0.1:2080"
NO_PROXY="localhost,127.0.0.1,::1,0.0.0.0"
